[gd_scene format=3 uid="uid://mainmenu"]

[ext_resource type="Script" path="res://scripts/mainMenu.gd" id="1_script"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.08, 0.06, 0.12, 1)

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -200.0
offset_top = -130.0
offset_right = 200.0
offset_bottom = 130.0
grow_horizontal = 2
grow_vertical = 2
alignment = 1

[node name="Title" type="Label" parent="VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 4
text = "MIAUGORITMOS"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 52

[node name="Spacer" type="Control" parent="VBoxContainer"]
layout_mode = 2
custom_minimum_size = Vector2(0, 40)

[node name="PlayButton" type="Button" parent="VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 4
custom_minimum_size = Vector2(200, 55)
text = "JUGAR"
theme_override_font_sizes/font_size = 28

[node name="NamePanel" type="VBoxContainer" parent="VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 4
visible = false

[node name="NameLabel" type="Label" parent="VBoxContainer/NamePanel"]
layout_mode = 2
size_flags_horizontal = 4
text = "¿Cómo te llamas? (3-10 caracteres)"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 18

[node name="NameInput" type="LineEdit" parent="VBoxContainer/NamePanel"]
layout_mode = 2
size_flags_horizontal = 4
custom_minimum_size = Vector2(200, 40)
max_length = 10
placeholder_text = "Tu nombre..."
alignment = 1

[node name="ErrorLabel" type="Label" parent="VBoxContainer/NamePanel"]
layout_mode = 2
size_flags_horizontal = 4
text = ""
horizontal_alignment = 1
theme_override_font_sizes/font_size = 16
theme_override_colors/font_color = Color(1, 0.3, 0.3, 1)
visible = false

[node name="ConfirmButton" type="Button" parent="VBoxContainer/NamePanel"]
layout_mode = 2
size_flags_horizontal = 4
custom_minimum_size = Vector2(200, 50)
text = "CONFIRMAR"
theme_override_font_sizes/font_size = 24

[connection signal="pressed" from="VBoxContainer/PlayButton" to="." method="_on_play_button_pressed"]
[connection signal="pressed" from="VBoxContainer/NamePanel/ConfirmButton" to="." method="_on_confirm_button_pressed"]
