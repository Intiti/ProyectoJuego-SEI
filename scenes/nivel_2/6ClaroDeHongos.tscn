codigo_ejercicio = "E2.6"
titulo_ejercicio = "E2.6 · La poción de los hongos lunares"
objetivo_aprendizaje = "OA3: ciclo con decremento de paso variable"
contexto_npc = "Alquimista Fael"
texto_instrucciones = "La poción mágica hierve a 30 grados y debe enfriarse en agitaciones de a 5 grados.
Usa un ciclo while para mostrar la temperatura mientras sea mayor que 10; al alcanzar la temperatura ideal muestra «Poción lista»."
explicaciones_error = {
"    temp = 10": "Fijar 10 de golpe corta el proceso sin el enfriamiento paso a paso.",
"    temp = temp + 5": "Sumar calienta la poción en vez de enfriarla.",
"while temp < 10:": "La temperatura inicial es 30, por lo que nunca entraría al ciclo.",
"while temp == 10:": "Como inicia en 30, la condición temp == 10 es falsa de inmediato."
}

