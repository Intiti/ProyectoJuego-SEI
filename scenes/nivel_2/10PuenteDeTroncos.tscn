script = ExtResource("12_ejercicio")
codigo_ejercicio = "E2.10"
titulo_ejercicio = "E2.10 · El puente de troncos"
objetivo_aprendizaje = "OA3: ciclo con acumulador y condición compuesta"
contexto_npc = "Constructor Bram"
texto_instrucciones = "El constructor arma un puente de troncos que soporta un peso total menor a 20 unidades y un máximo de menos de 5 troncos.\nDebes leer el peso de cada tronco, acumularlo y detenerte cuando el peso total llegue a 20 o se hayan colocado 5 troncos; luego muestra el peso total."
plantilla_codigo = PackedStringArray("peso_total = 0", "piezas = 0", "[?]", "    peso = int(input())", "[?]", "[?]", "print(peso_total)")
respuestas_correctas = PackedStringArray("while peso_total < 20 and piezas < 5:", "    peso_total = peso_total + peso", "    piezas = piezas + 1")
bloques_disponibles = PackedStringArray("while peso_total < 20 and piezas < 5:", "    peso_total = peso_total + peso", "    piezas = piezas + 1", "while peso_total < 20 or piezas < 5:", "    peso_total = peso", "    piezas = piezas - 1", "while peso_total >= 20 and piezas >= 5:")
explicaciones_error = {
"    peso_total = peso": "Sobrescribe el acumulado en vez de sumar el nuevo peso al total previo.",
"    piezas = piezas - 1": "Restar piezas aleja el contador del límite de 5 troncos.",
"while peso_total < 20 or piezas < 5:": "Con 'or' podría seguir colocando troncos aunque una de las dos condiciones de salida ya se haya cumplido.",
"while peso_total >= 20 and piezas >= 5:": "Las variables inician en 0, por lo que nunca entraría al ciclo."
}
pistas = PackedStringArray("Usa 'and' para que el ciclo solo continúe mientras AMBOS límites se respeten (peso < 20 y piezas < 5).", "Acumula el peso en cada vuelta ('peso_total = peso_total + peso') e incrementa las piezas.")

