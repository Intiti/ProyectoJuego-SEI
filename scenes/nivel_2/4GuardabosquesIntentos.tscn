codigo_ejercicio = "E2.4"
titulo_ejercicio = "E2.4 · El guardabosques y los intentos"
objetivo_aprendizaje = "OA3: bandera y repetición hasta acertar"
contexto_npc = "Guardabosques Kaelen"
texto_instrucciones = "El guardabosques cuida el paso hacia la espesura y pide la contraseña «hoja» las veces que sea necesario.\nDebes repetir la lectura por teclado hasta que la clave ingresada sea «hoja» y solo entonces mostrar «Acceso permitido»."
plantilla_codigo = PackedStringArray("clave = \"\"", "[?]", "[?]", "[?]")
respuestas_correctas = PackedStringArray("while clave != \"hoja\":", "    clave = input()", "print(\"Acceso permitido\")")
bloques_disponibles = PackedStringArray("while clave != \"hoja\":", "    clave = input()", "print(\"Acceso permitido\")", "while clave == \"hoja\":", "if clave != \"hoja\":", "    clave = \"hoja\"", "print(\"Acceso bloqueado\")")
explicaciones_error = {
"    clave = \"hoja\"": "Asignar la clave fija en el código no permite que el usuario ingrese su respuesta por teclado.",
"if clave != \"hoja\":": "Un 'if' solo revisa una vez, no permite repetir los intentos hasta que se acierte.",
"print(\"Acceso bloqueado\")": "Cuando el ciclo termina se acertó la clave; no debe mostrarse acceso bloqueado.",
"while clave == \"hoja\":": "La condición de repetición está invertida: como clave comienza vacía (''), el ciclo nunca se iniciaría."
}
pistas = PackedStringArray("Repite con 'while clave != \"hoja\":', lee la clave con 'clave = input()' y muestra el acceso fuera del ciclo.", "El ciclo debe continuar mientras la clave NO sea igual a 'hoja'.")

