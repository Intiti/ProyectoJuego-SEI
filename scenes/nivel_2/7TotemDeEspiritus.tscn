codigo_ejercicio = "E2.7"
titulo_ejercicio = "E2.7 · El despertar del tótem astral"
objetivo_aprendizaje = "OA3: ciclo con bandera booleana"
contexto_npc = "Chamán Zephyr"
texto_instrucciones = "El tótem ancestral inicia en reposo (activado = False).\nConsulta orbes con input() mientras no esté activado. Si el orbe es «sagrado», activa la bandera para culminar el ciclo y muestra «Espíritu despierto»."
