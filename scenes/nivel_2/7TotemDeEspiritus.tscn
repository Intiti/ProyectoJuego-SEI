respuestas_correctas = PackedStringArray("while not activado:", "        activado = True")
bloques_disponibles = PackedStringArray("while not activado:", "        activado = True", "while activado:", "        activado = False", "if not activado:", "        orbe = \"sagrado\"")
explicaciones_error = {
"        activado = False": "Mantiene la bandera apagada y el ciclo continuará indefinidamente.",
"        orbe = \"sagrado\"": "Modificar el texto del orbe no actualiza la bandera booleana de salida.",
"if not activado:": "Un condicional 'if' solo evalúa una vez, no repite para más orbes.",
"while activado:": "Como activado es False al inicio, el ciclo nunca comenzaría."
}
pistas = PackedStringArray("El ciclo debe continuar mientras el tótem no esté activo: 'while not activado:'.", "Al encontrar el orbe sagrado, actualiza la bandera con 'activado = True'.")

